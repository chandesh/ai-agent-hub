# Database Configuration
# Note: Application uses dedicated user 'ai_agent_app', not admin 'postgres'
DATABASE_URL=postgresql://ai_agent_app:ai_agent_app_password@localhost:5435/ai_agent_hub

# Environment
ENVIRONMENT=development
DEBUG=true

# Security (JWT)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# API
API_TITLE=AI Agent Hub API
API_VERSION=0.1.0

# Optional: enables GitHub API 5000/hr instead of 10/min for ingestion
GITHUB_TOKEN=
